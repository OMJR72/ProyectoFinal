meta {
  name: Cambiar Password
  type: http
  seq: 7
}

post {
  url: http://168.231.75.12:5173/api/usuarios/cambiar-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "123456",
    "newPassword": "nueva123"
  }
}
